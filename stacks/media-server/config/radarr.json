{
  "_comment": "Applied by `make apply-media-config`. `naming` -> /api/v3/config/naming, `mediamanagement` -> /api/v3/config/mediamanagement (merged into the current object, so unlisted keys keep their value). `rootFolders` are created if missing.",
  "naming": {
    "renameMovies": true,
    "replaceIllegalCharacters": true,
    "colonReplacementFormat": "smart",
    "standardMovieFormat": "{Movie Title} ({Release Year}) {Quality Full}",
    "movieFolderFormat": "{Movie Title} ({Release Year})"
  },
  "mediamanagement": {
    "recycleBin": "/data/recycle/movies",
    "recycleBinCleanupDays": 14,
    "copyUsingHardlinks": true,
    "importExtraFiles": true,
    "extraFileExtensions": "srt,sub,idx",
    "deleteEmptyFolders": true,
    "autoRenameFolders": false,
    "setPermissionsLinux": false,
    "minimumFreeSpaceWhenImporting": 100
  },
  "rootFolders": ["/data/movies"]
}
