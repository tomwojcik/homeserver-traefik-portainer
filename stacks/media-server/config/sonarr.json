{
  "_comment": "Applied by `make apply-media-config`. `naming` -> /api/v3/config/naming, `mediamanagement` -> /api/v3/config/mediamanagement (merged into the current object, so unlisted keys keep their value). `rootFolders` are created if missing. `seasonFolders: true` switches every series to per-season folders.",
  "naming": {
    "renameEpisodes": true,
    "replaceIllegalCharacters": true,
    "multiEpisodeStyle": 5,
    "standardEpisodeFormat": "{Series Title} - S{season:00}E{episode:00} - {Episode Title} {Quality Full}",
    "dailyEpisodeFormat": "{Series Title} - {Air-Date} - {Episode Title} {Quality Full}",
    "animeEpisodeFormat": "{Series Title} - S{season:00}E{episode:00} - {Episode Title} {Quality Full}",
    "seriesFolderFormat": "{Series Title}",
    "seasonFolderFormat": "Season {season}",
    "specialsFolderFormat": "Specials"
  },
  "mediamanagement": {
    "recycleBin": "/data/recycle/tv",
    "recycleBinCleanupDays": 14,
    "copyUsingHardlinks": true,
    "importExtraFiles": true,
    "extraFileExtensions": "srt,sub,idx",
    "deleteEmptyFolders": true,
    "createEmptySeriesFolders": false,
    "setPermissionsLinux": false,
    "minimumFreeSpaceWhenImporting": 100
  },
  "rootFolders": ["/data/tv"],
  "seasonFolders": true
}
